__pycache__/
*.pyc
*.log

# caches and per-epoch artefacts are regenerated, never shipped
runs/hpo_cache/
runs/results/ref_cache/
runs/results/fields/
runs/**/checkpoints/
runs/_refine_driver_*.py

# figures are regenerated by the scripts, never shipped
*.png
*.pdf

# paper figures are versioned
!figures/*.pdf

# TensorBoard logs written by scripts/monitor_training.py
runs/studies/*/tensorboard/

# outputs of scripts/cell_models/cycles_vs_dfn.py (one folder per run), regenerated
runs/cell_models/
